{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Fun\u00e7\u00e3o do usu\u00e1rio"
    },
    "creditos": {
      "type": "number",
      "default": 0,
      "description": "Cr\u00e9ditos para gera\u00e7\u00e3o de thumbnails"
    },
    "analises_restantes_mes": {
      "type": "number",
      "default": 20,
      "description": "An\u00e1lises de roteiro dispon\u00edveis neste m\u00eas"
    },
    "ultimo_reset_analises": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo reset das an\u00e1lises"
    }
  }
}