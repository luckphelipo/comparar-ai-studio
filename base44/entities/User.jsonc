{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "Papel do usu\u00e1rio no sistema"
    },
    "creditos": {
      "type": "number",
      "default": 10,
      "description": "Cr\u00e9ditos dispon\u00edveis para o usu\u00e1rio"
    }
  }
}