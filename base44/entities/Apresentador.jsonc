{
  "name": "Apresentador",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do apresentador"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto principal do apresentador"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o visual da pessoa (tom de pele, cabelo, estilo, etc.)"
    },
    "fotos_extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos adicionais de refer\u00eancia"
    }
  },
  "required": [
    "nome",
    "foto_url"
  ]
}