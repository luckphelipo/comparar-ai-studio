{
  "name": "AnalisesRoteiro",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do roteiro analisado"
    },
    "funil": {
      "type": "string",
      "enum": [
        "topo",
        "fundo"
      ],
      "description": "Tipo de funil da an\u00e1lise"
    },
    "texto_roteiro": {
      "type": "string",
      "description": "Texto completo do roteiro original"
    },
    "score_geral": {
      "type": "number",
      "description": "Pontua\u00e7\u00e3o geral da an\u00e1lise"
    },
    "resumo": {
      "type": "string",
      "description": "Resumo da an\u00e1lise realizada"
    },
    "resultado_completo": {
      "type": "object",
      "description": "Objeto JSON completo da an\u00e1lise com todos os detalhes"
    }
  },
  "required": [
    "titulo",
    "funil",
    "score_geral",
    "texto_roteiro",
    "resultado_completo"
  ]
}