{
  "name": "Roteiro",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do roteiro"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou resumo do roteiro"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado completo do roteiro"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_revisao",
        "pronto_producao",
        "finalizado"
      ],
      "default": "em_revisao",
      "description": "Status de produ\u00e7\u00e3o do roteiro"
    },
    "score": {
      "type": "number",
      "description": "Score de qualidade dado pela IA (0-100)"
    },
    "editor": {
      "type": "string",
      "description": "Nome do editor respons\u00e1vel"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "review",
        "tutorial",
        "comparativo",
        "vlog",
        "shorts"
      ],
      "default": "review",
      "description": "Categoria do v\u00eddeo"
    }
  },
  "required": [
    "titulo"
  ]
}